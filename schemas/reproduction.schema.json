{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paoding Reproduction Runs",
  "type": "object",
  "required": ["version", "runs"],
  "properties": {
    "version": {"type": "string"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "adapter", "status", "empirical"],
        "properties": {
          "id": {"type": "string"},
          "adapter": {"type": "string"},
          "status": {"enum": ["unverified", "attempted", "verified"]},
          "empirical": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
